<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="!T,V6]5_UQwL4;[wVu,s">tradesCounter</variable>
    <variable id="1Gp/v]LP27,I/mi@$;US">NAME</variable>
    <variable id="`=|V?TV%1c6]^Pvh=CK/">Loss</variable>
    <variable id="9dQ4tsj$@`vWpu;:2{K=">Stake</variable>
    <variable id="T{(x6lh:.m:xcqT0`!+3">maxLosses</variable>
    <variable id="!P]:?:q)?v?}qINF%J42">Win Stake</variable>
    <variable id="DNhF.v}O9v+rRicP?%xS">text</variable>
    <variable id=":Fbza.{0*q*jalJ+tc#.">Expected Profit</variable>
    <variable id="BTQ{$u318X:bRnhP(mQ9">Stop Loss</variable>
    <variable id="*fDA|@cvrn4wRkcZ,PWX">tradesNo</variable>
  </variables>

  <!-- ===== TRADE DEFINITION SECTION ===== -->
  <block type="trade_definition" id="trade_def" deletable="false" x="0" y="50">
    <statement name="TRADE_OPTIONS">
      <!-- ***** Market Selection ***** -->
      <block type="trade_definition_market" id="marketBlock" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <!-- For example, Volatility 75(1s) index: replace 1HZ75V if you prefer another symbol -->
        <field name="SYMBOL_LIST">1HZ75V</field>
        <next>
          <!-- ***** Trade Type: "callput" for Rise/Fall ***** -->
          <block type="trade_definition_tradetype" id="typeBlock" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">higherlower</field>
            <next>
              <!-- ***** Contract Type: Both (we'll pick Higher/Lower in "Before Purchase") ***** -->
              <block type="trade_definition_contracttype" id="contractBlock" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <!-- ***** Candle Interval: 1 minute (example) ***** -->
                  <block type="trade_definition_candleinterval" id="intervalBlock" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <!-- ***** Time Machine OFF / Restart on error ON ***** -->
                      <block type="trade_definition_restartbuysell" id="restartBlock" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="errorBlock" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ===== INITIALIZATION SECTION ===== -->
    <statement name="INITIALIZATION">
      <block type="text_print" id="printInit">
        <value name="TEXT">
          <shadow type="text" id="initShadowText">
            <field name="TEXT">Welcome to Bollinger Rise/Fall Bot</field>
          </shadow>
        </value>
        <next>
          <!-- ***** Initialize Variables ***** -->
          <block type="variables_set" id="initStake">
            <field name="VAR" id="9dQ4tsj$@`vWpu;:2{K=">Stake</field>
            <value name="VALUE">
              <block type="math_number" id="stakeNumber">
                <field name="NUM">10</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="initWinStake">
                <field name="VAR" id="!P]:?:q)?v?}qINF%J42">Win Stake</field>
                <value name="VALUE">
                  <block type="math_number" id="winStakeNumber">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="initLoss">
                    <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="lossNum">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="initMaxLoss">
                        <field name="VAR" id="T{(x6lh:.m:xcqT0`!+3">maxLosses</field>
                        <value name="VALUE">
                          <block type="math_number" id="maxLossNumber">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="initExpProfit">
                            <field name="VAR" id=":Fbza.{0*q*jalJ+tc#.">Expected Profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="expProfitNumber">
                                <field name="NUM">100</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="initStopLoss">
                                <field name="VAR" id="BTQ{$u318X:bRnhP(mQ9">Stop Loss</field>
                                <value name="VALUE">
                                  <block type="math_number" id="stopLossNumber">
                                    <field name="NUM">50</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="initTradesNo">
                                    <field name="VAR" id="*fDA|@cvrn4wRkcZ,PWX">tradesNo</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="tradesNoNumber">
                                        <field name="NUM">50</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="initCounter">
                                        <field name="VAR" id="!T,V6]5_UQwL4;[wVu,s">tradesCounter</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="counter0">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ===== "SUBMARKET" SECTION (Often Used for Additional Logic) ===== -->
    <statement name="SUBMARKET">
      <!-- 
        This area previously had digit-logic if/then blocks. 
        We'll keep a simple example to handle consecutive losses:
      -->
      <block type="controls_if" id="submarketIf1">
        <value name="IF0">
          <block type="logic_compare" id="checkLossEqual">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="lossVarGet">
                <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get" id="maxLossVarGet">
                <field name="VAR" id="T{(x6lh:.m:xcqT0`!+3">maxLosses</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <!-- If consecutive Loss == maxLoss, reset Loss and stake to WinStake -->
          <block type="variables_set" id="resetLoss">
            <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
            <value name="VALUE">
              <block type="math_number" id="zeroVar">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="resetStakeIfLoss">
                <field name="VAR" id="9dQ4tsj$@`vWpu;:2{K=">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="winStakeGet">
                    <field name="VAR" id="!P]:?:q)?v?}qINF%J42">Win Stake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- ===== BEFORE PURCHASE ===== -->
  <block type="before_purchase" id="beforePurchaseBlock" deletable="false" x="40" y="950">
    <statement name="BEFOREPURCHASE_STACK">
      <!-- Increment trades counter, limit total trades -->
      <block type="variables_set" id="incTradesCounter">
        <field name="VAR" id="!T,V6]5_UQwL4;[wVu,s">tradesCounter</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="addTrades">
            <field name="OP">ADD</field>
            <value name="A">
              <shadow type="math_number" id="oneNum">
                <field name="NUM">1</field>
              </shadow>
              <block type="variables_get" id="tradesCounterGet">
                <field name="VAR" id="!T,V6]5_UQwL4;[wVu,s">tradesCounter</field>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number" id="zeroNum2">
                <field name="NUM">0</field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="limitTradesIf">
            <value name="IF0">
              <block type="logic_compare" id="compareTrades">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="variables_get" id="tradesCounterVarGet">
                    <field name="VAR" id="!T,V6]5_UQwL4;[wVu,s">tradesCounter</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="tradesNoVarGet">
                    <field name="VAR" id="*fDA|@cvrn4wRkcZ,PWX">tradesNo</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <!-- If trades >= tradesNo, stop the bot -->
              <block type="controls_stop" id="stopAfterXTrades">
                <field name="STOP_TYPE">STOP</field>
              </block>
            </statement>
            <next>
              <!-- ============ BOLLINGER BANDS LOGIC ============ -->
              <block type="variables_set" id="setClosePrice">
                <field name="VAR" id="closePriceVar">closePrice</field>
                <value name="VALUE">
                  <!-- Candle #1 close -->
                  <block type="ohlc" id="ohlcClose">
                    <field name="OHLCFIELD">close</field>
                    <field name="CANDLEINDEX">1</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="setBollTop">
                    <field name="VAR" id="bollTopVar">upperBand</field>
                    <value name="VALUE">
                      <block type="indicators_bb" id="indicatorsBBTop">
                        <mutation base="Close"></mutation>
                        <field name="PERIOD">20</field>
                        <field name="DEVIATION">2</field>
                        <field name="FIELD">close</field>
                        <field name="CANDLEINDEX">1</field>
                        <field name="BANDS">BBANDSTOP</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="setBollMid">
                        <field name="VAR" id="bollMidVar">middleBand</field>
                        <value name="VALUE">
                          <block type="indicators_bb" id="indicatorsBBMid">
                            <mutation base="Close"></mutation>
                            <field name="PERIOD">20</field>
                            <field name="DEVIATION">2</field>
                            <field name="FIELD">close</field>
                            <field name="CANDLEINDEX">1</field>
                            <field name="BANDS">BBANDSMID</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="setBollLow">
                            <field name="VAR" id="bollLowVar">lowerBand</field>
                            <value name="VALUE">
                              <block type="indicators_bb" id="indicatorsBBLow">
                                <mutation base="Close"></mutation>
                                <field name="PERIOD">20</field>
                                <field name="DEVIATION">2</field>
                                <field name="FIELD">close</field>
                                <field name="CANDLEINDEX">1</field>
                                <field name="BANDS">BBANDSBOTTOM</field>
                              </block>
                            </value>
                            <next>
                              <!-- Check if closePrice <= lowerBand => BUY RISE (Call) -->
                              <block type="controls_if" id="ifLowerBand">
                                <value name="IF0">
                                  <block type="logic_compare" id="compareCloseLow">
                                    <field name="OP">LTE</field>
                                    <value name="A">
                                      <block type="variables_get" id="closePriceGet">
                                        <field name="VAR" id="closePriceVar">closePrice</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get" id="lowerBandGet">
                                        <field name="VAR" id="bollLowVar">lowerBand</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <!-- Purchase "Higher" -->
                                  <block type="purchase" id="purchaseRise">
                                    <field name="PURCHASE_LIST">CALL</field>
                                  </block>
                                </statement>
                                <next>
                                  <!-- Else if closePrice >= upperBand => BUY FALL (Put) -->
                                  <block type="controls_if" id="ifUpperBand">
                                    <value name="IF0">
                                      <block type="logic_compare" id="compareCloseHigh">
                                        <field name="OP">GTE</field>
                                        <value name="A">
                                          <block type="variables_get" id="closePriceGet2">
                                            <field name="VAR" id="closePriceVar">closePrice</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get" id="upperBandGet">
                                            <field name="VAR" id="bollTopVar">upperBand</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <!-- Purchase "Lower" -->
                                      <block type="purchase" id="purchaseFall">
                                        <field name="PURCHASE_LIST">PUT</field>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- ===== AFTER PURCHASE ===== -->
  <block type="after_purchase" id="afterPurchaseBlock" x="40" y="1600">
    <statement name="AFTERPURCHASE_STACK">
      <!-- If WIN: reset stake to Win Stake, reset Loss=0 -->
      <block type="controls_if" id="afterPurchaseIfWin">
        <mutation elseif="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="checkWin">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="setStakeOnWin">
            <field name="VAR" id="9dQ4tsj$@`vWpu;:2{K=">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="winStakeAgain">
                <field name="VAR" id="!P]:?:q)?v?}qINF%J42">Win Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="setLossZeroOnWin">
                <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
                <value name="VALUE">
                  <block type="math_number" id="loss0">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>

        <!-- If LOSS: Loss++ and mild stake increase -->
        <value name="IF1">
          <block type="contract_check_result" id="checkLoss">
            <field name="CHECK_RESULT">loss</field>
          </block>
        </value>
        <statement name="DO1">
          <block type="variables_set" id="incrementLoss">
            <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="addLossCount">
                <field name="OP">ADD</field>
                <value name="A">
                  <shadow type="math_number" id="oneShadowLoss">
                    <field name="NUM">1</field>
                  </shadow>
                  <block type="variables_get" id="curLossVarGet">
                    <field name="VAR" id="`=|V?TV%1c6]^Pvh=CK/">Loss</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number" id="oneShadowLoss2">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <!-- Mild Martingale: stake *= 1.5, for example -->
              <block type="variables_set" id="martingaleOnLoss">
                <field name="VAR" id="9dQ4tsj$@`vWpu;:2{K=">Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="calcStakeOnLoss">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <shadow type="math_number" id="shadowOne">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="variables_get" id="stakeVarGetForMartingale">
                        <field name="VAR" id="9dQ4tsj$@`vWpu;:2{K=">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number" id="shadowMult">
                        <field name="NUM">1.5</field>
                      </shadow>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>

      <!-- Additional checks: Stop if total profit <= -StopLoss or >= ExpectedProfit -->
      <block type="controls_if" id="checkStopLossProfit" inline="false">
        <mutation elseif="2"></mutation>
        <value name="IF0">
          <!-- if total_profit <= -StopLoss -->
          <block type="logic_compare" id="cmpNegStop">
            <field name="OP">LTE</field>
            <value name="A">
              <block type="total_profit" id="tpNegCheck" />
            </value>
            <value name="B">
              <block type="math_arithmetic" id="negStopVal">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <shadow type="math_number" id="neg1">
                    <field name="NUM">-1</field>
                  </shadow>
                </value>
                <value name="B">
                  <shadow type="variables_get" id="stopLossVarRef">
                    <field name="VAR" id="BTQ{$u318X:bRnhP(mQ9">Stop Loss</field>
                  </shadow>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <!-- Stop if we exceed negative stopLoss -->
          <block type="controls_stop" id="stopIfStopLoss">
            <field name="STOP_TYPE">STOP</field>
          </block>
        </statement>

        <value name="IF1">
          <!-- if total_profit >= ExpectedProfit -->
          <block type="logic_compare" id="cmpExpProfit">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="total_profit" id="tpPosCheck"/>
            </value>
            <value name="B">
              <block type="variables_get" id="expProfVarGet">
                <field name="VAR" id=":Fbza.{0*q*jalJ+tc#.">Expected Profit</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO1">
          <!-- Stop if we exceed the expected profit target -->
          <block type="controls_stop" id="stopIfTakeProfit">
            <field name="STOP_TYPE">STOP</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
